{
  "name": "Product Hunt Daily Startup Leads to Google Sheets (HTTP-First Apify)",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup Instructions\n1. Replace `<YOUR_APIFY_TOKEN>` in the **Fetch Product Hunt Launches (Apify)** HTTP Request node (Header: `Authorization: Bearer <YOUR_APIFY_TOKEN>`).\n2. Connect your **Google Sheets OAuth2** credentials in the **Append Lead to Google Sheets** node and select your target Spreadsheet & Sheet.\n3. Recommended Google Sheet columns: `scrapedAt`, `dailyRank`, `name`, `tagline`, `websiteUrl`, `tractionScore`, `votesCount`, `commentsCount`, `emails`, `xUrls`, `linkedinUrls`, `discordUrls`, `url`.\n4. `incrementalMode: true` uses Apify KeyValueStore state (`ph-delta-state`) so daily runs only emit new or updated launches.",
        "height": 260,
        "width": 520,
        "color": 4
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Setup Guide",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [220, 60]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/ajengayu89~producthunt-intelligence-scraper/run-sync-get-dataset-items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <YOUR_APIFY_TOKEN>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mode\": \"leaderboard\",\n  \"period\": \"daily\",\n  \"maxItems\": 30,\n  \"enrichStartupContacts\": true,\n  \"incrementalMode\": true,\n  \"stateKey\": \"ph-delta-state\",\n  \"proxyConfiguration\": {\n    \"useApifyProxy\": true\n  }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Fetch Product Hunt Launches (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-outreach-ready",
              "leftValue": "={{ $json.outreachReady }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Filter Outreach Ready",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [760, 380]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "<YOUR_GOOGLE_SHEET_ID>",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "scrapedAt": "={{ $json.scrapedAt }}",
            "dailyRank": "={{ $json.dailyRank }}",
            "name": "={{ $json.name }}",
            "tagline": "={{ $json.tagline }}",
            "websiteUrl": "={{ $json.websiteUrl }}",
            "tractionScore": "={{ $json.tractionScore }}",
            "votesCount": "={{ $json.votesCount }}",
            "commentsCount": "={{ $json.commentsCount }}",
            "emails": "={{ ($json.emails || []).join(', ') }}",
            "xUrls": "={{ ($json.xUrls || []).join(', ') }}",
            "linkedinUrls": "={{ ($json.linkedinUrls || []).join(', ') }}",
            "discordUrls": "={{ ($json.discordUrls || []).join(', ') }}",
            "url": "={{ $json.url }}"
          }
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Append Lead to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1020, 380]
    }
  ],
  "pinData": {},
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Product Hunt Launches (Apify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Product Hunt Launches (Apify)": {
      "main": [
        [
          {
            "node": "Filter Outreach Ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Outreach Ready": {
      "main": [
        [
          {
            "node": "Append Lead to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "10000000-0000-4000-8000-000000000001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
